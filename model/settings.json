{
  "_comment": "Template, Claude Code on macOS: the fragment to MERGE into ~/.claude/settings.json; the other keys of the user's file stay as they are. One way to set it, not a requirement (guide.md). The reason for each line, and how the file is applied, are in setup/claude-code-macos.md, step 3; what was tried and what was only read is in environments/claude-code-macos.md. In this file a permission rule's path is ~/… or //abs — a bare /… would be relative to ~/.claude/ — and a sandbox path is anchored at ~/.claude unless it begins ~/ or /.",
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Edit(~/.netrc)",
      "Read(~/.config/gh/**)",
      "Edit(~/.config/gh/**)",
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.claude/.credentials.json)",
      "Edit(**/.git/hooks/**)",
      "Edit(**/.git/config)",
      "Bash(gh auth:*)",
      "Bash(git credential:*)",
      "Bash(security:*)",
      "mcp__ccd_directory__request_directory",
      "mcp__ccd_directory__change_directory",
      "mcp__ccd_session_mgmt__set_session_permission_mode",
      "mcp__ccd_session__hand_off_to_session",
      "mcp__ccd_session__move_to_cloud",
      "mcp__ccd_session_mgmt__set_remote_control"
    ],
    "ask": [
      "Edit(~/.claude/**)",
      "mcp__ccd_session__start_session"
    ],
    "blockReadsOutsideWorkingDirectories": true,
    "blockWritesOutsideWorkingDirectories": true
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "excludedCommands": [
      "git push *",
      "git pull *",
      "git fetch *",
      "gh *"
    ],
    "filesystem": {
      "denyWrite": [
        "~/**/.claude/settings.json",
        "~/**/.claude/settings.local.json",
        "~/**/.claude/hooks/**"
      ]
    }
  }
}
